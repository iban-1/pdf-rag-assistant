# Which LLM backend to use: "groq" (hosted, free tier, default) or "ollama" (local)
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Used when LLM_PROVIDER=ollama (must have `ollama serve` running locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
